# Connection used by the application at runtime.
# This MUST point at the restricted `grip_app` role, which has NOBYPASSRLS
# and owns nothing. Tenant isolation depends on it.
DATABASE_URL="postgresql://grip_app:PASSWORD@HOST:5432/postgres?sslmode=require"

# Connection used by migrations, seeds and tests-that-set-up-fixtures only.
# This is the owning role and DOES bypass RLS. Never used to serve a request.
DATABASE_URL_OWNER="postgresql://postgres:PASSWORD@HOST:5432/postgres?sslmode=require"

# 32+ random bytes, base64. Signs the session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# Session lifetime in days.
SESSION_TTL_DAYS=14

# RESEND_API_KEY + PLATFORM_NOTIFY_FROM are used for two things now
# (src/lib/notify.ts): the platform console's optional operator alerts
# (support requests, failed-login floods, privilege grants — the console and
# its bell work fine without them), AND the "Forgot password?" emails on the
# login page, which have no in-app fallback — without these set, a password
# reset link is never actually delivered. PLATFORM_NOTIFY_TO is only used by
# the former. Use a Resend account/domain of GRIP's own — never gripshopos.com
# email sent through another project's domain or account.
RESEND_API_KEY=""
PLATFORM_NOTIFY_FROM="notifications@gripshopos.com"
PLATFORM_NOTIFY_TO="admin@gripshopos.com"
